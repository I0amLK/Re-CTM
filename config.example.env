# Optional fixed OAuth public origin. Omit this for a loopback-bound Quick Tunnel;
# Re-CTM will derive the HTTPS issuer/resource from the trusted local proxy request.
# Set it for named tunnels or any stable production hostname.
# RE_CTM_SERVER_URL=https://re-ctm.example.com
# Optional. If omitted, `re-ctm serve` generates a high-entropy authorization
# key and prints it once to the local terminal for the operator to enter on the
# first OAuth authorization page.
# RE_CTM_OAUTH_PASSWORD=replace-with-an-operator-password

# Native user-visible workspace. It must not contain RE_CTM_DATA_ROOT.
RE_CTM_WORKSPACE=/path/to/native-workspace

# Server-owned data and workflow-private state. Keep this outside the workspace.
RE_CTM_DATA_ROOT=/var/lib/re-ctm
RE_CTM_PRIVATE_ROOT=/var/lib/re-ctm/private
RE_CTM_DEBUG_ROOT=/var/lib/re-ctm/debug

# Native CMT authority. Dangerous never grants Rethlas workflow authority.
RE_CTM_NATIVE_MODE=safe

# On Linux, when bwrap is installed and this variable is omitted, Re-CTM
# automatically selects the built-in Bubblewrap backend and performs fail-closed
# attestation at every startup. Set disabled only when command execution should
# be intentionally unavailable.
# RE_CTM_NATIVE_EXEC_BACKEND=disabled
# RE_CTM_NATIVE_EXEC_BACKEND=bubblewrap
# RE_CTM_NATIVE_EXEC_BACKEND=external
# RE_CTM_NATIVE_EXEC_HELPER=/usr/local/libexec/re-ctm-native-helper
# Optional Bubblewrap-only fallback for toolchains whose runtime/library roots
# cannot be inferred from PATH or executable symlinks. Use absolute directories,
# separated by ':' on Linux. Every root is canonicalized, overlap-checked against
# workspace/data/private state, and mounted read-only.
# RE_CTM_NATIVE_EXEC_ALLOW_ROOTS=/opt/vendor-suite:/srv/shared-math-runtime
# The acknowledgement flag is required only for an external helper. The built-in
# Bubblewrap backend proves its isolation properties at startup instead.
# RE_CTM_NATIVE_ISOLATION_ATTESTED=1

# required | if_available | static_only
# Production should use required. static_only is for deterministic local tests.
RE_CTM_LATEX_POLICY=required

# Optional browser Origins, comma-separated. Loopback Origins are allowed by default.
RE_CTM_ALLOWED_ORIGINS=https://chat.example.com

# Rethlas theorem retrieval. Results are always treated as unverified until the
# active reasoning domain reads the source context and checks applicability.
RE_CTM_THEOREM_SEARCH_URL=https://leansearch.net/thm/search
RE_CTM_THEOREM_SEARCH_TIMEOUT_SECONDS=30

# Optional hex secrets (at least 32 bytes each). When omitted, Re-CTM creates a
# server-owned OAuth secret and derives a separate capability secret without
# printing either value.
# RE_CTM_TOKEN_SECRET=<64-or-more-hex-characters>
# RE_CTM_CAPABILITY_SECRET=<64-or-more-hex-characters>

# Debug events are always structured and redacted. Payload capture remains off by default.
RE_CTM_DEBUG=1
RE_CTM_TRACE_PAYLOADS=0
